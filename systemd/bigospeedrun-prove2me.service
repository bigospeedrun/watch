[Unit]
Description=Big O Speedrun #prove2me reader, every minute (read-only Discord reader, sends new messages to BOS Lead Dev)

[Service]
Type=oneshot
WorkingDirectory=%h/nil/bigospeedrun-data
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/nil/bigospeedrun-data/problem_selection_watch.py --channel prove2me --via webhook
StandardOutput=journal
StandardError=journal
