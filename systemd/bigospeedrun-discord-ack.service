[Unit]
Description=Big O Speedrun #submit-a-result acknowledger, every minute (adds the eyes reaction to each new human message)

[Service]
Type=oneshot
WorkingDirectory=%h/nil/bigospeedrun-data
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/nil/bigospeedrun-data/discord_ack.py
StandardOutput=journal
StandardError=journal
