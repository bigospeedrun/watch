{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "problem_id",
    "model",
    "score",
    "tiers",
    "verification",
    "records",
    "maintainers",
    "agents",
    "submission_url",
    "rules_url"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "problem_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "description",
        "definition_url"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "definition_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        }
      }
    },
    "score": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "symbol",
        "definition",
        "direction",
        "encoding",
        "minimum",
        "maximum"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "enum": [
            "higher-is-better",
            "lower-is-better"
          ]
        },
        "encoding": {
          "const": "rational-string"
        },
        "minimum": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "maxLength": 256
        },
        "maximum": {
          "type": "string",
          "pattern": "^-?(0|[1-9][0-9]*)(/[1-9][0-9]*)?$",
          "maxLength": 256
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "enum": [
          "verified",
          "certified-conditional",
          "claimed"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "verification": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "profile",
            "working_directory",
            "result_path"
          ],
          "properties": {
            "command": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "profile": {
              "type": "string",
              "minLength": 1
            },
            "working_directory": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            },
            "result_path": {
              "type": "string",
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
            }
          }
        }
      ]
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "format",
        "adapter"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$"
        },
        "format": {
          "enum": [
            "bos-records-v1",
            "adapter-v1"
          ]
        },
        "adapter": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1
            }
          ]
        }
      }
    },
    "maintainers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "github",
          "role"
        ],
        "properties": {
          "github": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]+$"
          },
          "role": {
            "enum": [
              "owner",
              "moderator"
            ]
          }
        }
      },
      "minItems": 1
    },
    "agents": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "AGENTS.md"
        }
      ]
    },
    "submission_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "rules_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigospeedrun.com/schemas/manifest-v1.json",
  "title": "Proposed Big O Speedrun manifest v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "tiers": {
            "contains": {
              "enum": [
                "verified",
                "certified-conditional"
              ]
            }
          }
        }
      },
      "then": {
        "properties": {
          "verification": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "records": {
            "properties": {
              "format": {
                "const": "bos-records-v1"
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "properties": {
              "adapter": {
                "type": "null"
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "records": {
            "properties": {
              "adapter": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  ]
}
