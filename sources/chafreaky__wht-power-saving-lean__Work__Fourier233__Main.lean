namespace OAI

/-!
Exact uniform Fourier transforms and convolution.

The construction formalizes the exact arithmetic algorithms of
*An explicit power saving for the exact discrete Fourier transform* (OpenAI).
The finite phase network originates in the complex construction of
*Integer multiplication below n log n*.

`transform_mainY` and `convolution_mainY` give fixed finite RAM programs, including
preparation and index work, polynomial storage bounds, and a canonical root whose
order is computed from the input length. Each includes the paper exponent, decimal
power saving, and little-o bound. The `_order` variants also specify the root order.

The implementation uses a smaller concrete tensor network (32 binary coordinates
per factor, 4060 triples, and a `2^50` role envelope) with a stronger saving that
implies the stated paper constants. The general rational-algebra extraction,
symbolic certificate search, circuit printer, and bounded-printer uniformization
from the synthesis appendix are outside this formalization.
-/
namespace PowerSaving
open RAM Bench Selection Filter Asymptotics Real
noncomputable section
namespace Skies

lemma multiplier_rangeY : 1 < paperMultiplier ∧ paperMultiplier < paperM := by
  norm_num [paperMultiplier,paperM,paperDelta,paperW]

lemma theta_ltY : theta < 1 := by
  have h := multiplier_rangeY
  have hg : 0<log paperM := Real.log_pos (lt_trans h.1 h.2)
  rw [theta,div_lt_iff₀ hg,one_mul]
  exact Real.log_lt_log (by linarith) h.2

lemma alpha_thetaY : alphaY < theta := by
  let d : ℝ := 7547361/(10:ℝ)^10
  have hp : 0<d := by dsimp [d]; norm_num
  have hm : 2 ≤ paperM := by norm_num [paperM]
  have hx : 0<paperMultiplier := lt_trans zero_lt_one multiplier_rangeY.1
  have hu : 0<paperM := by linarith
  have h2 := (Real.log_le_log (by norm_num : 0 < (2:ℝ)) hm)
  have he := log2_minY
  have hh : 0<log paperM := by linarith
  have hk := Real.log_le_sub_one_of_pos (show 0<paperM/paperMultiplier by positivity)
  rw [log_div hu.ne' hx.ne'] at hk
  have H : paperM/paperMultiplier-1 < d*(2/3) := by
    norm_num [d,paperM,paperMultiplier,paperW,paperDelta]
  rw [theta,lt_div_iff₀ hh]
  change (1-d)*log paperM < log paperMultiplier
  have H' := mul_le_mul_of_nonneg_left (he.trans h2) hp.le
  have hy := hk.trans_lt (lt_of_lt_of_le H H')
  rw [sub_mul,one_mul]
  linarith only [hy]

lemma decimal_rangeY : alphaY < decimalExponentY ∧ decimalExponentY < 1 := by
  norm_num [decimalExponentY,alphaY]

def speedY (v : ℝ) (n : ℕ) := (n:ℝ)*(TmY n)^v

lemma flight_littleY {v : ℝ} (h : alphaY < v) :
    flightY =o[atTop] speedY v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopY.eventually_ge_atTop 1,dwarfY TtopY 2
    (p:=v-alphaY) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmY n := by linarith
  change ‖(n:ℝ)*TmY n^alphaY*QmY n^2‖ ≤ c*‖(n:ℝ)*TmY n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  calc
    _ ≤ ((n:ℝ)*TmY n^alphaY)*(c*TmY n^(v-alphaY)) :=
      mul_le_mul_of_nonneg_left hh (by positivity)
    _ = c*((n:ℝ)*(TmY n^alphaY*TmY n^(v-alphaY))) := by ring
    _ = _ := by rw [← rpow_add he, show alphaY + (v-alphaY)=v by ring] -- a+(v-a)

lemma speed_littleY {u v : ℝ} (h : u < v) :
    speedY u =o[atTop] speedY v := by
  rw [isLittleO_iff]
  intro c hc
  filter_upwards [TtopY.eventually_ge_atTop 1,dwarfY TtopY 0
    (p:=v-u) (sub_pos.mpr h) hc] with n hn hh
  have he : 0<TmY n := by linarith
  change ‖(n:ℝ)*TmY n^u‖ ≤ c*‖(n:ℝ)*TmY n^v‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity)]
  have hh' : 1 ≤ c * TmY n^(v-u) := by simpa only [pow_zero] using hh
  calc
    _ = ((n:ℝ)*TmY n^u)*1 := by ring
    _ ≤ ((n:ℝ)*TmY n^u)*(c*TmY n^(v-u)) := mul_le_mul_of_nonneg_left hh' (by positivity)
    _ = c*((n:ℝ)*(TmY n^u*TmY n^(v-u))) := by ring
    _ = _ := by rw [← rpow_add he, show u+(v-u)=v by ring]

theorem decimal_littleY : decimalTimeY =o[atTop] nlogn := by
  have H := speed_littleY decimal_rangeY.2
  have h : speedY 1 = nlogn := funext fun n => by rw [speedY,Real.rpow_one]; rfl
  rw [h] at H; exact H

lemma speed_paperY : speedY theta =O[atTop] paperTime := by
  rw [isBigO_iff]
  refine ⟨1,?_⟩
  filter_upwards [TtopY.eventually_ge_atTop 1,QtopY.eventually_ge_atTop 1] with n hn hh
  have he : 0<TmY n := by linarith
  have he' : 0<QmY n := by linarith
  change ‖(n:ℝ)*TmY n^theta‖ ≤ 1*‖(n:ℝ)*TmY n^theta*QmY n^(4-theta)‖
  rw [Real.norm_of_nonneg (by positivity),Real.norm_of_nonneg (by positivity),one_mul]
  have hb := Real.one_le_rpow hh (show 0 ≤ 4-theta by linarith [theta_ltY])
  exact le_mul_of_one_le_right (by positivity) hb

lemma time_boundY {N} (h : ∀ n:ℕ,n ≤ N n ∧ N n ≤ 2*n) (a b : RationY) :
    TimeBoundsY (lunchY a b N) := by
  have H := lunch_bigY a b h
  have hp := H.trans_isLittleO (flight_littleY alpha_thetaY)
  have hd := H.trans_isLittleO (flight_littleY decimal_rangeY.1)
  have ht : (fun n => (lunchY a b N n:ℝ)) =O[atTop] decimalTimeY := hd.isBigO
  exact ⟨hp.isBigO.trans speed_paperY,ht,ht.trans_isLittleO decimal_littleY⟩

end Skies

/-! Main results. Provide formula for the order besides the existential specification. -/
theorem transform_main_orderY : ∃ order solve W,
    DFTProgram order solve W ∧ TimeBoundsY W ∧
    ∀ n, 0<n → (run order n).val = receipt n ∧ (run order n).val < 8*n^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipOneY
  exact ⟨o,s,lunchY a b id,hp,Skies.time_boundY (N:=id) (fun n => ⟨le_rfl,by dsimp; omega⟩)
    a b,fun n hn => ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound n hn).2⟩⟩

theorem convolution_main_orderY : ∃ order solve W,
    ConvProgram order solve W ∧ TimeBoundsY W ∧
    ∀ n, 0<n → (run order n).val = receipt (2*n-1) ∧ (run order n).val < 8*(2*n-1)^3 := by
  obtain ⟨o,s,a,b,hp,ho⟩ := flagshipBothY
  have h (n : ℕ) : n ≤ stretchY n ∧ stretchY n ≤ 2*n := by unfold stretchY; omega
  exact ⟨o,s,lunchY a b stretchY,hp,Skies.time_boundY h a b,fun n hn =>
    ⟨ho n hn,(ho n hn).symm ▸ (receipt_bound _ (stretch_posY hn)).2⟩⟩

/-- **The discrete Fourier transform of every length in `O(n (log n)^(1 - 7547360/10^10))`.**
OpenAI's `transform_main` (one fixed program, OpenAI's own `DFTProgram`, `paperTime` and `nlogn`)
with the decimal exponent `1 - 1/10^13` replaced by `decimalExponentY = 1 - 7547360/10^10`
(Work/Fourier233/Goal.lean). Sibling of the Walsh-Hadamard theorem `wht_main_block_B2Gp233x`: both
follow from one kernel program, `RAM.hillsY_program` (Work/Fourier233/Seam.lean). -/
theorem transform_mainY : DFTGoalY :=
  let ⟨o,s,W,h,g,_⟩ := transform_main_orderY
  ⟨o,s,W,h,g⟩

/-- **Convolution of every length with the same bounds** (OpenAI's `convolution_main`, same change). -/
theorem convolution_mainY : ConvGoalY :=
  let ⟨o,s,W,h,g,_⟩ := convolution_main_orderY
  ⟨o,s,W,h,g⟩

lemma matrix_definitionY (n : ℕ) (x : Vec n) : dft n x = Matrix.mulVec (dftMatrix n) x :=
  rfl

